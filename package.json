{
  "name": "nook-editor",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "description": "An offline-first creative workspace for stories, visual diaries, and personal archives.",
  "author": {
    "name": "Nook Project",
    "email": "sujal-GITHUB@users.noreply.github.com"
  },
  "desktopName": "Nook",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --base=./",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "desktop": "npm run build:desktop && electron .",
    "dist": "npm run build:desktop && electron-builder --publish never",
    "dist:linux": "npm run build:desktop && electron-builder --linux AppImage deb --publish never",
    "dist:windows": "npm run build:desktop && electron-builder --win dir --x64 --publish never && node desktop/build-windows-installer.mjs",
    "dist:mac": "npm run build:desktop && electron-builder --mac dmg zip --universal --publish never"
  },
  "dependencies": {
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "lucide-react": "^0.468.0",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.2"
  },
  "build": {
    "appId": "com.nook.workspace",
    "productName": "Nook",
    "artifactName": "Nook-${os}-${arch}.${ext}",
    "asar": true,
    "directories": { "output": "release", "buildResources": "build" },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "node_modules/sql.js/**/*"
    ],
    "linux": {
      "category": "Office",
      "syncDesktopName": true,
      "maintainer": "Nook Project <sujal-GITHUB@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/app-icon-512.png"
    },
    "win": {
      "icon": "public/app-icon.svg",
      "target": [
        "dir"
      ]
    },
    "mac": {
      "icon": "public/app-icon.svg",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
